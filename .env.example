# PostgreSQL connection string (required).
# Local: use a local Postgres instance or a free hosted DB (e.g. Neon, Supabase).
# Vercel: set this in Project Settings → Environment Variables (e.g. from Vercel Postgres or Neon).
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/epicmap"

# Optional: override admin password (Rolodex/CRM). Default: epictest123
# EPIC_ADMIN_SECRET=epictest123
